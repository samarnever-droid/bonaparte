{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bonaparte",
  "version": "0.1.0",
  "identifier": "app.bonaparte.dev",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Bonaparte",
